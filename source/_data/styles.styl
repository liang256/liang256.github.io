$paper = #f4f1ea
$paper-soft = #ebe5d9
$ink = #24201b
$muted = #766d62
$faint = #b9afa2
$accent = #8c3f2f
$accent-soft = rgba(140, 63, 47, .12)

html
  background: $paper

body
  background: $paper
  color: $ink
  font-family: Georgia, 'Times New Roman', 'Noto Serif TC', 'Noto Serif CJK TC', serif
  font-size: 18px
  letter-spacing: 0
  line-height: 1.78

::selection
  background: $accent-soft
  color: $ink

a
  border-bottom-color: rgba(140, 63, 47, .24)
  color: $accent

a:hover
  border-bottom-color: $accent
  color: #5f2b22

.headband
  display: none

.main
  background: linear-gradient(90deg, rgba(0, 0, 0, .025), transparent 22%, transparent 78%, rgba(0, 0, 0, .018))
  padding-top: 0

.main-inner
  max-width: 760px
  width: calc(100% - 48px)

.header
  background: transparent
  margin: 0 auto
  max-width: 760px
  width: calc(100% - 48px)

.header-inner
  background: transparent
  border-bottom: 1px solid rgba(36, 32, 27, .14)
  border-radius: 0
  box-shadow: none
  padding: 54px 0 18px

.site-brand-container
  background: transparent

.site-meta
  text-align: left

.brand
  border-bottom: 0
  color: $ink
  display: inline-block
  padding: 0

.logo-line
  display: none

.site-title
  font-family: Georgia, 'Times New Roman', serif
  font-size: 2.15em
  font-weight: 400
  letter-spacing: 0
  line-height: 1.08

.site-subtitle
  color: $muted
  font-size: .9em
  margin: 8px 0 0
  text-align: left

.site-nav
  margin-top: 24px
  text-align: left

.menu
  margin: 0

.menu .menu-item
  margin: 0 22px 0 0

.menu .menu-item a
  border-bottom: 0
  color: $muted
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
  font-size: .76em
  letter-spacing: .08em
  padding: 0
  text-transform: uppercase

.menu .menu-item a:hover
  color: $accent

.post-block
  background: transparent
  border-bottom: 1px solid rgba(36, 32, 27, .12)
  border-radius: 0
  box-shadow: none
  margin: 0
  padding: 56px 0

.posts-expand .post-block:first-child
  padding-top: 46px

.post-title
  font-family: Georgia, 'Times New Roman', 'Noto Serif TC', 'Noto Serif CJK TC', serif
  font-size: 1.9em
  font-weight: 400
  letter-spacing: 0
  line-height: 1.24
  margin: 0

.post-title-link
  border-bottom: 0
  color: $ink

.post-title-link:hover
  color: $accent

.post-meta-container
  color: $muted
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
  font-size: .78em
  letter-spacing: .02em
  margin-top: 12px

.post-description
  color: $muted
  font-family: Georgia, 'Times New Roman', 'Noto Serif TC', serif
  font-size: 1.03rem
  font-style: italic
  letter-spacing: 0
  line-height: 1.65
  margin-top: 18px

.post-body
  color: $ink
  font-size: 1em
  line-height: 1.86
  margin-top: 30px

.post-body h2,
.post-body h3,
.post-body h4
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
  font-weight: 600
  letter-spacing: .02em

.post-body h2
  border-bottom: 1px solid rgba(36, 32, 27, .12)
  font-size: 1.05em
  margin-top: 2.4em
  padding-bottom: .25em

.post-body h3
  font-size: .96em

.post-body p,
.post-body ul,
.post-body ol,
.post-body blockquote
  margin-bottom: 1.25em

.post-body blockquote
  border-left: 2px solid $faint
  color: #514a42
  margin-left: 0
  padding: .2em 0 .2em 1.2em

.post-body code
  background: rgba(36, 32, 27, .06)
  border-radius: 3px
  color: #4c342d
  font-size: .86em
  padding: .12em .28em

.highlight,
pre
  background: #eee8dc
  border: 1px solid rgba(36, 32, 27, .1)
  border-radius: 4px

.post-button .btn
  background: transparent
  border: 1px solid rgba(140, 63, 47, .35)
  border-radius: 999px
  color: $accent
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
  font-size: .75em
  letter-spacing: .08em
  padding: 3px 16px
  text-transform: uppercase

.post-button .btn:hover
  background: $accent-soft
  border-color: $accent

.post-eof
  display: none

.post-tags a
  background: rgba(36, 32, 27, .055)
  border: 0
  border-radius: 999px
  color: $muted
  display: inline-block
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
  font-size: .76em
  margin: 0 8px 8px 0
  padding: 3px 10px

.post-tags a:hover
  background: $accent-soft
  color: $accent

.pagination
  border-top: 0
  margin: 42px 0

.pagination .page-number,
.pagination .extend
  border: 0
  color: $muted

.pagination .current
  background: transparent
  color: $ink
  font-weight: 700

.footer
  background: transparent
  color: $muted
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
  font-size: .78em

.footer-inner
  border-top: 1px solid rgba(36, 32, 27, .12)
  max-width: 760px
  padding: 22px 0 42px
  width: calc(100% - 48px)

table
  font-size: .9em

hr
  background: rgba(36, 32, 27, .14)
  height: 1px

@media (max-width: 767px)
  body
    font-size: 17px

  .header,
  .main-inner,
  .footer-inner
    width: calc(100% - 32px)

  .header-inner
    padding-top: 36px

  .site-title
    font-size: 1.72em

  .menu .menu-item
    margin-right: 14px

  .post-block
    padding: 38px 0

  .post-title
    font-size: 1.55em
