{%- set page_keywords = page.keywords or config.keywords %}
{%- if page_keywords %}
<meta name="keywords" content="{% if page_keywords.join %}{{ page_keywords | join(', ') | escape }}{% else %}{{ page_keywords | escape }}{% endif %}">
{%- endif %}

<meta name="author" content="{{ config.author | escape }}">
<meta name="robots" content="{{ page.robots or 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}">
<link rel="sitemap" type="application/xml" href="{{ config.url }}/sitemap.xml">
